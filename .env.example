# Sessiya imzosi uchun maxfiy kalit (kamida 32 belgi).
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Mock autentifikatsiya. Ishlab chiqishda (dev) har doim yoniq.
# Production build'da (masalan, Vercel preview) faqat "true" bo'lsa ishlaydi.
# Haqiqiy backend ulangach bu o'zgaruvchi va src/lib/mock/ olib tashlanadi.
MOCK_AUTH_ENABLED=true
# Login sahifasida demo hisoblar blokini ko'rsatish (ixtiyoriy)
SHOW_DEMO_ACCOUNTS=false

# AI yordamchi. Kalit bo'lsa chat haqiqiy Claude modelidan javob oladi, bo'lmasa namunaviy (mock) rejim.
# Kalit faqat serverda saqlanadi (NEXT_PUBLIC_ bilan boshlanmaydi). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Ixtiyoriy: model nomi (standart: claude-haiku-5-5; kuchliroq: claude-sonnet-5-5)
AI_MODEL=
